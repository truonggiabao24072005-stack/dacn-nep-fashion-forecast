-- Chay bang psql voi chu so huu CSDL; hai role phai duoc DBA tao truoc.
-- psql -v runtime_role=ten_role_ung_dung -v reader_role=ten_role_doc -f 04_phan_quyen_trien_khai.psql
-- Khong tao login, khong dat mat khau va khong doi quyen tai khoan dang chay demo.
\set ON_ERROR_STOP on
\if :{?runtime_role}
\else
  \echo 'Thieu runtime_role. Chua thay doi quyen.'
  DO $guard$ BEGIN RAISE EXCEPTION 'Thieu runtime_role'; END $guard$;
\endif
\if :{?reader_role}
\else
  \echo 'Thieu reader_role. Chua thay doi quyen.'
  DO $guard$ BEGIN RAISE EXCEPTION 'Thieu reader_role'; END $guard$;
\endif
SELECT EXISTS(
 SELECT 1 FROM pg_roles a,pg_roles b,pg_database d
 WHERE a.rolname=:'runtime_role' AND b.rolname=:'reader_role' AND a.oid<>b.oid
 AND d.datname=current_database() AND NOT a.rolsuper AND NOT b.rolsuper
 AND NOT a.rolcreatedb AND NOT b.rolcreatedb AND NOT a.rolcreaterole AND NOT b.rolcreaterole
 AND NOT a.rolbypassrls AND NOT b.rolbypassrls
 AND NOT pg_has_role(a.oid,d.datdba,'USAGE') AND NOT pg_has_role(b.oid,d.datdba,'USAGE')
 AND NOT pg_has_role(b.oid,'pg_read_all_data','MEMBER')
) AS roles_hop_le \gset
\if :roles_hop_le
\else
  \echo 'Role thieu, trung nhau hoac co quyen qua rong. Chua thay doi quyen.'
  DO $guard$ BEGIN RAISE EXCEPTION 'Role thieu, trung nhau hoac co quyen qua rong'; END $guard$;
\endif
BEGIN;
GRANT CONNECT ON DATABASE :"DBNAME" TO :"runtime_role",:"reader_role";
GRANT USAGE ON SCHEMA public TO :"runtime_role",:"reader_role";
REVOKE CREATE ON SCHEMA public FROM PUBLIC,:"runtime_role",:"reader_role";
GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA public TO :"runtime_role";
GRANT USAGE,SELECT ON ALL SEQUENCES IN SCHEMA public TO :"runtime_role";
REVOKE TRUNCATE,TRIGGER,REFERENCES ON ALL TABLES IN SCHEMA public FROM :"runtime_role";
REVOKE UPDATE,DELETE ON public.store_stockentry,public.store_stockposting,public.store_salepayment,
 public.store_auditevent,public.store_operationrequest FROM :"runtime_role";
GRANT EXECUTE ON FUNCTION public.nep_immutable(),public.nep_doc_guard(),public.nep_line_guard(),
 public.nep_variant_guard(),public.nep_product_guard(),public.nep_balance_check(),public.nep_assert_posting(bigint),
 public.nep_check_commit(),public.nep_forecast_guard(),public.nep_web_snapshot_guard(),
 public.nep_web_check(),public.nep_parent_link_guard(),public.nep_web_transition_guard(),
 public.nep_web_lifecycle(uuid) TO :"runtime_role";
REVOKE ALL ON ALL TABLES IN SCHEMA public FROM :"reader_role";
REVOKE ALL ON ALL SEQUENCES IN SCHEMA public FROM :"reader_role";
GRANT SELECT ON public.v_nep_ton_kho,public.v_nep_don_ban,public.v_nep_so_kho,
 public.v_nep_du_bao,public.v_nep_su_kien_doanh_thu,public.v_nep_yeu_cau_web TO :"reader_role";
COMMIT;
